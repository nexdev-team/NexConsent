msgid "Cookie settings"
msgstr "Ρυθμίσεις cookies"

msgid "Your choice could not be saved. Optional services remain off."
msgstr "Δεν αποθηκεύτηκε η επιλογή. Οι προαιρετικές υπηρεσίες παραμένουν ανενεργές."

msgid "Cookie / service"
msgstr "Cookie / υπηρεσία"

msgid "Purpose"
msgstr "Σκοπός"

msgid "Duration"
msgstr "Διάρκεια"

msgid "Stores the categories, date and version of your choice."
msgstr "Αποθηκεύει τις κατηγορίες, την ημερομηνία και την έκδοση της επιλογής σου."

msgid "180 days"
msgstr "180 ημέρες"

msgid "According to store settings"
msgstr "Σύμφωνα με τις ρυθμίσεις του καταστήματος"

msgid "According to service settings"
msgstr "Σύμφωνα με τις ρυθμίσεις της υπηρεσίας"

msgid "Necessary cookies keep the site working. We use analytics and marketing cookies only with your permission."
msgstr "Τα αναγκαία cookies υποστηρίζουν τη λειτουργία του site. Μόνο με τη συγκατάθεσή σου χρησιμοποιούμε cookies στατιστικών και marketing."

msgid "Remember your choices and support the session and site security."
msgstr "Αποθηκεύουν την επιλογή σου και υποστηρίζουν τη συνεδρία και την ασφάλεια του site."

msgid "Other services"
msgstr "Άλλες υπηρεσίες"

