msgid "Your cookie choices"
msgstr "Η επιλογή σου για τα cookies"

msgid "Necessary cookies keep the site and basket working. We use analytics and marketing cookies only with your permission."
msgstr "Τα αναγκαία cookies υποστηρίζουν το site και το καλάθι. Μόνο με τη συγκατάθεσή σου χρησιμοποιούμε cookies στατιστικών και marketing."

msgid "Accept all"
msgstr "Αποδοχή όλων"

msgid "Reject optional"
msgstr "Απόρριψη προαιρετικών"

msgid "Settings"
msgstr "Ρυθμίσεις"

msgid "Save choices"
msgstr "Αποθήκευση επιλογών"

msgid "Close"
msgstr "Κλείσιμο"

msgid "Cookie policy"
msgstr "Πολιτική cookies"

msgid "Always active"
msgstr "Πάντα ενεργά"

msgid "Necessary"
msgstr "Αναγκαία"

msgid "Analytics"
msgstr "Στατιστικά"

msgid "Marketing"
msgstr "Marketing"

msgid "Remember your choices and support the basket, session and site security."
msgstr "Αποθηκεύουν την επιλογή σου και υποστηρίζουν το καλάθι, τη συνεδρία και την ασφάλεια του site."

msgid "Help us understand how the site is used and improve it."
